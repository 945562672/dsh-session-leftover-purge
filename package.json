{
  "name": "dsh-session-leftover-purge",
  "version": "1.1.7",
  "description": "删除会话后清理 bili 与 cost-meter 残留 / Purge bili & cost-meter leftovers after a session is deleted",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "author": "fenri",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "billion-context",
    "bili",
    "session",
    "cleanup",
    "sqlite"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/945562672/dsh-session-leftover-purge.git"
  },
  "homepage": "https://github.com/945562672/dsh-session-leftover-purge#readme",
  "bugs": {
    "url": "https://github.com/945562672/dsh-session-leftover-purge/issues"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.4 <4",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "^0.1.7-rc.1 || ^0.2.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-plugin-manager": {
      "optional": true
    }
  }
}
